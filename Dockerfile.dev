# ===========================================
# Pony Town - Development Docker Build
# ===========================================
# Optimized for development with --local flag (no OAuth required)

FROM node:22-alpine AS builder

# Update package index and install build dependencies
# Split into steps to avoid apk cache issues
RUN apk update && \
    apk add --no-cache \
    python3 \
    py3-pip \
    make \
    g++ \
    gcc \
    musl-dev \
    git && \
    apk add --no-cache imagemagick || true

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for development)
RUN npm ci --legacy-peer-deps && \
    npm cache clean --force

# Copy source code
COPY . .

# Compile TypeScript
RUN npm run ts

# Build production assets
RUN npm run build

# ===========================================
# Development Runtime (lighter than production)
FROM node:22-alpine

# Install runtime dependencies
RUN apk add --no-cache \
    imagemagick \
    tini

WORKDIR /app

# Copy everything from builder (dev mode keeps more files)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src/scripts ./src/scripts
COPY --from=builder /app/assets ./assets
COPY --from=builder /app/public ./public
COPY --from=builder /app/views ./views
COPY --from=builder /app/favicons ./favicons
COPY --from=builder /app/pony-town.js ./
COPY --from=builder /app/package.json ./
COPY --from=builder /app/cli.js ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S ponytown -u 1001 && \
    chown -R ponytown:nodejs /app

USER ponytown

# Expose ports
EXPOSE 8090 8091

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s \
    CMD node -e "require('http').get('http://localhost:8090/api/state', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use tini to handle signals properly
ENTRYPOINT ["/sbin/tini", "--"]

# Development mode with --local flag (enables mock login, no OAuth needed)
CMD ["node", "pony-town.js", "--login", "--admin", "--game", "--local"]
