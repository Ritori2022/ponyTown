# ===========================================
# Pony Town - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# ============================================
# MongoDB Configuration
# ============================================
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme123
MONGO_DATABASE=ponytown

# ============================================
# Application Ports
# ============================================
GAME_PORT=8090
ADMIN_PORT=8091
HTTP_PORT=80
HTTPS_PORT=443

# ============================================
# Application Configuration
# ============================================
# These are configured in config.json, not here
# See config-template.json for full configuration options

# Example config.json structure:
# {
#   "title": "My Pony Town",
#   "port": 8090,
#   "adminPort": 8091,
#   "host": "https://yourdomain.com/",
#   "secret": "YOUR_SESSION_SECRET_HERE",
#   "token": "YOUR_API_TOKEN_HERE",
#   "db": "mongodb://admin:changeme123@mongodb:27017/ponytown?authSource=admin",
#   "oauth": {
#     "google": {
#       "clientID": "YOUR_GOOGLE_CLIENT_ID",
#       "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
#     }
#   }
# }

# ============================================
# OAuth Configuration (for config.json)
# ============================================
# Get these from respective OAuth provider dashboards:

# Google OAuth: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Twitter OAuth: https://developer.twitter.com/
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# ============================================
# Security
# ============================================
# Generate secure random strings for these:
# SESSION_SECRET=$(openssl rand -base64 32)
# API_TOKEN=$(openssl rand -base64 32)
